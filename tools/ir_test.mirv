language hedral;

type Address;
type Index;
type Scalar;
type Coordinate;
type Domain;
type AffineTransform;
type AffineAddressOperator;

operator IntroduceIterationDomain(h : Host<LG_Polyhedron>) -> Domain;
operator IntroduceAffineTransform(h : Host<LG_AffineTransform>) -> AffineTransform;
operator IntroduceAffineAddressOperator(h : Host<LG_AffineTransform>) -> AffineAddressOperator;

operator For (iter_domain : Domain, block : Block) -> Bound<Coordinate>;
operator ApplyAffineTransform (coord : Coordinate, atran : AffineTransform) -> Coordinate;
operator ApplyAffineAddressOperator (addr_op : AffineAddressOperator, coord : Coordinate) -> Coordinate;
operator Access (addr : Address) -> Scalar;
operator Add (x0 : Scalar, x1 : Scalar) -> Scalar;
operator Multiply (x0 : Scalar, x1 : Scalar) -> Scalar;

stencil contraction (
    iteration_domain : Host<LG_Polyhedron>,

    y_transform  :  Host<LG_AffineTransform>,
    x0_transform :  Host<LG_AffineTransform>,
    x1_transform :  Host<LG_AffineTransform>,

    y_addr_op  :    Host<LG_AffineTransform>,
    x0_addr_op :    Host<LG_AffineTransform>,
    x1_addr_op :    Host<LG_AffineTransform>,
) {
    %D : Domain = IntroduceIterationDomain(iteration_domain);

    %y_transfor   : AffineTransform = IntroduceAffineTransform(y_transform);
    %x0_transform : AffineTransform = IntroduceAffineTransform(x0_transform);
    %x1_transform : AffineTransform = IntroduceAffineTransform(x1_transform);

    %y_addr_op  :   AddressOperator = IntroduceAffineAddressOperator(y_addr_op);
    %x0_addr_op :   AddressOperator = IntroduceAffineAddressOperator(x0_addr_op);
    %x1_addr_op :   AddressOperator = IntroduceAffineAddressOperator(x1_addr_op);

    %induction_vector : Bound<Coordinate> = For(%D, {
        %y_coord :  Coordinate = ApplyAffineTransform(%induction_vector, %y_transform);
        %y_addr  :  Address    = ApplyAffineAddressOperator(%y_addr_op, %y_coord);

        %x0_coord : Coordinate = ApplyAffineTransform(%induction_vector, %x0_transform);
        %x0_addr  : Address    = ApplyAffineAddressOperator(%x0_addr_op, %x0_coord);

        %x1_coord : Coordinate = ApplyAffineTransform(%induction_vector, %x1_transform);
        %x1_addr  : Address    = ApplyAffineAddressOperator(%x1_addr_op, %x1_coord);

        %x0 : Scalar = Access(%x0_addr);
        %x1 : Scalar = Access(%x1_addr);
        %y  : Scalar = Multiply(%x0, %x1);

        YieldAccumulate(%y_addr, %y);
    });
}
